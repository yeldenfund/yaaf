# Yelden YAAF Scorer — environment variables
# Copy to .env and fill in your values

# API secret for authenticated endpoints
YELDEN_SECRET=your-secret-here

# Port (default 8080)
PORT=8080

# Polygon RPC (for on-chain submissions)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# AIAgentRegistry address (Polygon mainnet)
REGISTRY_ADDRESS=0xbC102cDec0DD007E7739ac213b62d5B031B22aF1

# Scorer private key (for updateScore() transactions)
SCORER_PRIVATE_KEY=your-private-key-here
